# ==========================================
# Project AIBO — Environment Configuration Template
# ==========================================
# Copy this file to .env and insert your personal API keys.
# DO NOT commit .env to version control!

# --- 1. Google Gemini (Default Primary Provider) ---
# Get your free key at: https://aistudio.google.com/app/apikey
# Free allowance: 15 Requests/Min, 1,500 Requests/Day (100% free forever)
GEMINI_API_KEY=your_gemini_api_key_here

# --- 2. NVIDIA NIM / Nemotron (Supported BYOK Provider) ---
# Get your key and free trial tokens at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_nemotron_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# --- 3. Optional Fallback: Groq (OpenAI-compatible) ---
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
